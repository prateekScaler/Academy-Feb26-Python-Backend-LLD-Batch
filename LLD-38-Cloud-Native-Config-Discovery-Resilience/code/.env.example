# LLD-38 — EXAMPLE environment file (SAFE TO COMMIT)
# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill in real values for local development:
#     cp .env.example .env
#
# The real ".env" must be GITIGNORED — it holds real secrets (API keys, DB
# passwords) that must never enter version control. This ".env.example" ships
# only PLACEHOLDERS so new teammates know which variables the app expects.
#
# Precedence at runtime:  real OS env var  >  .env  >  field default in code.
# ---------------------------------------------------------------------------

# Logical name of this service (used in logs / discovery). Has a code default.
SERVICE_NAME=orders-service

# Database connection string. Use your local DB here; prod injects its own.
DB_URL=postgres://user:CHANGE_ME@localhost:5432/orders

# Per-call network timeout in seconds (float). Keep small so calls never hang.
TIMEOUT_SECONDS=2.5

# Verbose logging + dev conveniences. NEVER true in production.
DEBUG=true

# SECRET — do NOT put a real key in this example file. In your real .env this
# is a live credential injected from your secrets manager / CI, never hardcoded.
API_KEY=sk-REPLACE-with-your-real-key
